#include <iostream>
using namespace std;

class BankAccount
{
    float bal;

public:
    void get()
    {
        cin >> bal;
    }

    void deposit(float d)
    {
        bal += d;
    }

    void withdraw(float w)
    {
        if (w <= bal)
            bal -= w;
        else
            cout << "Insufficient Balance\n";
    }

    void display()
    {
        cout << bal;
    }
};

int main()
{
    BankAccount b;
    float d, w;

    b.get();
    cin >> d >> w;

    b.deposit(d);
    b.withdraw(w);
    b.display();

    return 0;
}
